DATABASE_URL=
PORT=
SESSION_COOKIE_NAME=
# Set to true in production once the app is served over HTTPS, so the
# session cookie gets the Secure attribute. Keep false for local HTTP dev.
SECURE_COOKIES=
# Scheme+host the app is reachable at, used to build the link in a
# password-reset email. Defaults to http://localhost:$PORT if unset.
APP_BASE_URL=
# SMTP relay password-reset email is sent through (e.g. an app password on
# Gmail, or a free tier on Brevo/Mailgun). Leave blank to leave forgot-password
# working end to end except the actual send, which is logged instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
