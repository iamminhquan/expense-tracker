DATABASE_URL=
PORT=
SESSION_COOKIE_NAME=
# Signs and verifies access tokens (internal/auth/jwt.go). Required, with
# no fallback -- generate one with `openssl rand -base64 32` and never
# commit the real value. Rotating it invalidates every access token (but
# not refresh-token/session cookies, which are unaffected).
JWT_SECRET=
# Comma-separated origins the API's CORS middleware accepts credentialed
# cross-origin requests from -- the client/ dev server
# (http://localhost:5173) locally, its Vercel domain in production. Leave
# blank to allow none, which is correct for a backend-only deployment.
CORS_ALLOWED_ORIGINS=
# Set to true in production once the app is served over HTTPS, so the
# session cookie gets the Secure attribute. Keep false for local HTTP dev.
SECURE_COOKIES=
# Scheme+host of client/ (NOT this server) -- the password-reset and
# verify-email emails link to client/'s /reset-password and /verify-email
# routes, which this API doesn't answer itself. Defaults to
# http://localhost:5173 (Vite's default port) if unset; set to the real
# Vercel domain in production.
APP_BASE_URL=
# Brevo transactional-email API key password-reset email is sent through
# (Settings -> SMTP & API -> API Keys in the Brevo dashboard -- this is an
# API key, not the SMTP key on the same page). Deliberately HTTP rather than
# SMTP: Render's free tier blocks outbound traffic to every SMTP port, but
# never to 443. Leave blank to leave forgot-password working end to end
# except the actual send, which is logged instead.
BREVO_API_KEY=
# Must be a sender verified in the same Brevo account.
MAIL_FROM=
# Comma-separated IPs or CIDR ranges of the reverse proxies in front of this
# server, whose X-Forwarded-For is believed when finding a client's address
# for rate limiting. Leave blank locally (nothing sits in front). Behind a
# proxy it must be set: blank, every client shares the proxy's address and
# one rate-limit budget; set too wide, a client can name its own address.
TRUSTED_PROXIES=
